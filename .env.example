APP_NAME="Ferretti | Gestione Vestiario"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT
APP_TIMEZONE=Europe/Rome

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ferretti_vestiario
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Gestione Vestiario ---------------------------------------------
# Branding: percorsi relativi a /public. Lasciare vuoto per il branding provvisorio.
VESTIARIO_COMPANY_NAME="Ferretti Construction"
VESTIARIO_LOGO_PATH=
VESTIARIO_LOGO_DARK_PATH=
VESTIARIO_FAVICON_PATH=brand/favicon.svg
# Mostra il contrassegno "Dati demo" nell'interfaccia
VESTIARIO_DEMO_MODE=false
# Documento di consegna: modello .docx (vuoto = resources/templates/consegna.docx) e disco privato di archiviazione
VESTIARIO_TEMPLATE_CONSEGNA=
VESTIARIO_DOCUMENTI_DISCO=local
